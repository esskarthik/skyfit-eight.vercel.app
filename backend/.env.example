# Copy this to .env and fill your keys
PORT=4000

# --- Local/dev only ---
NODE_ENV=development

# --- OpenRouter (AI chat) ---
OPENROUTER_API_KEY=sk-or-...your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Supabase (required) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin panel bootstrap key (protects initial /api/admin/staff login) ---
ADMIN_KEY=change-me-long-random-string

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=rzp_test_...your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Device access control (door/gate devices) ---
DEVICE_ACCESS_KEY=change-me-long-random-string

# --- Vercel (set to true in production to skip local listen) ---
# VERCEL=true
